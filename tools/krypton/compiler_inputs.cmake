# Krypton: track toolchain binaries that source upgrades replace in place.
# Preserve the existing graph and let Ninja rebuild affected objects normally.
function(krypton_track_compiler_inputs directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(sources "${target}" SOURCES)
    get_target_property(source_directory "${target}" SOURCE_DIR)
    foreach(source IN LISTS sources)
      if(source MATCHES "\\.(c|cc|cpp|cxx)$" AND NOT source MATCHES "^\\$<")
        if(NOT IS_ABSOLUTE "${source}")
          set(source "${source_directory}/${source}")
        endif()
        set_property(SOURCE "${source}" DIRECTORY "${directory}" APPEND
          PROPERTY OBJECT_DEPENDS "${CMAKE_CXX_COMPILER}")
      endif()
    endforeach()
    get_target_property(type "${target}" TYPE)
    if(type MATCHES "^(SHARED_LIBRARY|MODULE_LIBRARY|EXECUTABLE)$")
      set_property(TARGET "${target}" APPEND PROPERTY LINK_DEPENDS "${CMAKE_LINKER}")
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    krypton_track_compiler_inputs("${child}")
  endforeach()
endfunction()
