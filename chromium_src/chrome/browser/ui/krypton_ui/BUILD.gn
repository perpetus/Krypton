# KryptonUI's C contract, vendored from the KryptonUI repository so Chromium
# compiles against a fixed copy. build.py --krypton-ui refuses to stage a
# module whose abi.h differs from this one.
#
# The runtime target is independent of browser Views; process-wide shutdown
# does not depend on per-window UI code.

import("//build/buildflag_header.gni")
import("//chrome/browser/ui/krypton_ui/features.gni")

# A private, statically linked Google Zucchini tool for the native updater.
# Reuse the browser's configured libraries without rebuilding the browser.
if (is_win) {
  executable("krypton_patch") {
    output_name = "KryptonPatch"
    sources = [
      "//components/zucchini/main_utils.cc",
      "//components/zucchini/main_utils.h",
      "//components/zucchini/zucchini_commands.cc",
      "//components/zucchini/zucchini_commands.h",
      "//components/zucchini/zucchini_main.cc",
    ]
    deps = [
      "//base",
      "//build/win:default_exe_manifest",
      "//components/zucchini:zucchini_io",
      "//components/zucchini:zucchini_lib",
    ]
  }
}
