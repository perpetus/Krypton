if (krypton_ui_enabled) {
  copy("runtime_files") {
    sources = [
      "$krypton_ui_runtime_dir/Microsoft.WindowsAppRuntime.Bootstrap.dll",
      "$krypton_ui_runtime_dir/krypton_ui.dll",
    ]
    outputs = [ "$root_out_dir/{{source_file_part}}" ]
  }

  copy("settings_assets") {
    sources = [
      "$krypton_ui_runtime_dir/assets/settings/hr_classic.png",
      "$krypton_ui_runtime_dir/assets/settings/hr_compact.png",
      "$krypton_ui_runtime_dir/assets/settings/hr_dyn.png",
      "$krypton_ui_runtime_dir/assets/settings/vt_compact.png",
      "$krypton_ui_runtime_dir/assets/settings/vt_sidebar.png",
      "$krypton_ui_runtime_dir/assets/settings/vt_sidebar_title.png",
    ]
    outputs = [ "$root_out_dir/assets/settings/{{source_file_part}}" ]
  }

  group("runtime_data") {
    public_deps = [
      ":runtime_files",
      ":settings_assets",
    ]
  }
}

