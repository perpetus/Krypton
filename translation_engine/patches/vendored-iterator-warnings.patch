Krypton: Fix the warnings Marian's vendored yaml-cpp and pathie headers raise.
Why: C++17 deprecates the std::iterator base; declare the iterator member
types directly, as upstream yaml-cpp 0.7 did, and cast the assert-only
CollectionStack parameter to void instead of evaluating it unused.
--- a/inference/marian-fork/src/3rd_party/yaml-cpp/collectionstack.h
+++ b/inference/marian-fork/src/3rd_party/yaml-cpp/collectionstack.h
@@ -27,7 +27,8 @@
     collectionStack.push(type);
   }
   void PopCollectionType(CollectionType::value type) {
-    assert(type == GetCurCollectionType()); type;
+    assert(type == GetCurCollectionType());
+    (void)type;
     collectionStack.pop();
   }
 
--- a/inference/marian-fork/src/3rd_party/yaml-cpp/node/detail/iterator.h
+++ b/inference/marian-fork/src/3rd_party/yaml-cpp/node/detail/iterator.h
@@ -18,8 +18,7 @@
 struct iterator_value;
 
 template <typename V>
-class iterator_base : public std::iterator<std::forward_iterator_tag, V,
-                                           std::ptrdiff_t, V*, V> {
+class iterator_base {
 
  private:
   template <typename>
@@ -36,7 +35,11 @@
   };
 
  public:
-  typedef typename iterator_base::value_type value_type;
+  using iterator_category = std::forward_iterator_tag;
+  using value_type = V;
+  using difference_type = std::ptrdiff_t;
+  using pointer = V*;
+  using reference = V;
 
  public:
   iterator_base() : m_iterator(), m_pMemory() {}
