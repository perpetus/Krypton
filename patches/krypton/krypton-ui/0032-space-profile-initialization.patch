Subject: Keep profile host presentation after window feature initialization

Creating a Space with a new profile resized the hidden host during widget
construction. Layout queried GetWidgetForAnchoring, which presented/activated
that host before InitPostWindowConstruction created its extension keyboard
registry. The null registry caused an access violation at address 0xb0.

Keep the anchor getter free of presentation side effects. Chromium's existing
embedder post-window hook marks the owned adapter initialized only after its
window-dependent services exist. Ignore premature show/activation notifications
and tolerate an absent optional keyboard registry. Owned host code also gates
presentation/resizing and explicitly deactivates each newly created registry.
No profile data is copied, migrated, deleted or read by this initialization fix.

--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -1739,11 +1739,6 @@
 }
 
 views::Widget* BrowserView::GetWidgetForAnchoring() {
-#if BUILDFLAG(ENABLE_KRYPTON_UI)
-  if (krypton_ui_) {
-    krypton_ui_->PresentForBrowserUI();
-  }
-#endif
 #if BUILDFLAG(IS_MAC)
   if (WindowFeatureController::From(browser())->UsesImmersiveFullscreenMode()) {
     return IsFullscreen() ? overlay_widget_.get() : GetWidget();
@@ -1795,6 +1790,9 @@
 void BrowserView::Show() {
 #if BUILDFLAG(ENABLE_KRYPTON_UI)
   if (krypton_ui_) {
+    if (!krypton_ui_->browser_initialized()) {
+      return;
+    }
     krypton_ui_->PresentForBrowserUI();
   }
 #endif
@@ -4460,6 +4458,11 @@
 void BrowserView::OnWidgetActivationChanged(views::Widget* widget,
                                             bool active) {
 #if BUILDFLAG(ENABLE_KRYPTON_UI)
+  // Native child widgets can notify while Browser is still constructing its
+  // window. Per-browser features are ready only after the embedder init hook.
+  if (krypton_ui_ && !krypton_ui_->browser_initialized()) {
+    return;
+  }
   if (krypton_ui_)
     krypton_ui_->PublishWindowState();
 #endif
@@ -4479,8 +4482,9 @@
     }
   }
 
-  ExtensionKeybindingRegistryViews::From(browser_)->OnHostActivationChanged(
-      active);
+  if (auto* keys = ExtensionKeybindingRegistryViews::From(browser_)) {
+    keys->OnHostActivationChanged(active);
+  }
 
   if (active) {
     UpdatePlatformAccelerators();
