+void ChromeRenderFrameObserver::CancelKryptonBoostPicker() {
+  const blink::WebScriptSource source(
+      blink::WebString::FromUtf8("globalThis.__kryptonBoostPicker?.()"));
+  render_frame()->GetWebFrame()->ExecuteScriptInIsolatedWorld(
+      ISOLATED_WORLD_ID_CHROME_INTERNAL, source,
+      blink::BackForwardCacheAware::kAllow);
+}
+void ChromeRenderFrameObserver::PickKryptonBoostElement(
+    PickKryptonBoostElementCallback callback) {
+  const auto document = render_frame()->GetWebFrame()->GetDocument();
+  if (document.IsNull() || !GURL(document.Url()).SchemeIsHTTPOrHTTPS()) {
+    std::move(callback).Run("");
+    return;
+  }
+  const blink::WebScriptSource source(
+      blink::WebString::FromUtf8(kKryptonBoostPicker));
+  render_frame()->GetWebFrame()->RequestExecuteScript(
+      ISOLATED_WORLD_ID_CHROME_INTERNAL, base::span_from_ref(source),
+      blink::mojom::UserActivationOption::kDoNotActivate,
+      blink::mojom::EvaluationTiming::kSynchronous,
+      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
+      base::BindOnce(
+          [](PickKryptonBoostElementCallback callback,
+             std::optional<base::Value> value, base::TimeTicks) {
+            std::move(callback).Run(value && value->is_string()
+                                        ? value->GetString()
+                                        : std::string());
+          },
+          std::move(callback)),
+      blink::BackForwardCacheAware::kAllow,
+      blink::mojom::WantResultOption::kWantResult,
+      blink::mojom::PromiseResultOption::kAwait, blink::WebString());
+}
+
+void ChromeRenderFrameObserver::SetKryptonSiteStyle(
+    const GURL& document_url,
+    const std::vector<std::string>& css) {
+  if (!document_url.SchemeIsHTTPOrHTTPS() || css.size() > 257)
+    return;
+  size_t bytes = 0;
+  for (const auto& sheet : css) {
+    bytes += sheet.size();
+    if (bytes > 1024 * 1024)
+      return;
+  }
+  const auto url = document_url.GetWithoutRef();
+  if (krypton_style_url_ == url && krypton_site_css_ == css &&
+      (!krypton_style_keys_.empty() || css.empty()))
+    return;
+  krypton_style_url_ = url;
+  krypton_site_css_ = css;
+  ApplyKryptonSiteStyle();
+}
+void ChromeRenderFrameObserver::ApplyKryptonSiteStyle() {
+  auto document = render_frame()->GetWebFrame()->GetDocument();
+  if (document.IsNull() ||
+      GURL(document.Url()).GetWithoutRef() != krypton_style_url_)
+    return;
+  for (const auto& key : krypton_style_keys_)
+    document.RemoveInsertedStyleSheet(key, blink::WebCssOrigin::kUser);
+  krypton_style_keys_.clear();
+  for (const auto& sheet : krypton_site_css_)
+    if (!sheet.empty())
+      krypton_style_keys_.push_back(
+          document.InsertStyleSheet(blink::WebString::FromUtf8(sheet), nullptr,
+                                    blink::WebCssOrigin::kUser));
+}
