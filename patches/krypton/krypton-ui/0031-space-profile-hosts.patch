 BrowserNativeWidget* BrowserNativeWidgetFactory::Create(
     BrowserWidget* browser_widget,
     BrowserView* browser_view) {
+#if BUILDFLAG(ENABLE_KRYPTON_UI)
+  // A Space of another profile shares its frame's window as a child widget.
+  if (auto* hosted = krypton_ui::CreateHostedBrowserNativeWidget(
+          browser_widget, browser_view)) {
+    return hosted;
+  }
+#endif
   return new BrowserNativeWidgetAura(browser_widget, browser_view);
 }
