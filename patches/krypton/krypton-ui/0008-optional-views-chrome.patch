+// Incognito dialogs anchor to the avatar button. A toolbar without one uses
+// its default bubble anchor.
+views::BubbleAnchor GetIncognitoDialogAnchor(BrowserWindowInterface& browser) {
+  ToolbarButtonProvider* const provider = ToolbarButtonProvider::From(&browser);
+  CHECK(provider);
+  if (AvatarToolbarButtonInterface* const avatar =
+          provider->GetAvatarToolbarButtonInterface()) {
+    return avatar->GetBubbleAnchor(browser);
+  }
+  return provider->GetBubbleAnchor(std::nullopt);
+}
