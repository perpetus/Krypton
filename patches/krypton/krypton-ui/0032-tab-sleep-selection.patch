+std::optional<int> TabStripModel::GetSelectionAfterRemovingTab(
+    tabs::TabInterface* tab) const {
+  const auto next = DetermineNewSelectedIndex(tab);
+  const int removed = GetIndexOfTab(tab);
+  return next ? std::optional(*next + (*next >= removed)) : std::nullopt;
+}
