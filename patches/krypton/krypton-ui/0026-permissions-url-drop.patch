     const ui::DropTargetEvent& event) {
+#if BUILDFLAG(ENABLE_KRYPTON_UI)
+  if (browser_view_->krypton_ui()) {
+    const gfx::PointF point(views::View::ConvertPointToTarget(
+        this, browser_view_, event.location()));
