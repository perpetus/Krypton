+      return {};
+    return base::BindOnce(
+        [](base::OnceClosure drop, const ui::DropTargetEvent& event,
+           ui::mojom::DragOperation& operation,
+           std::unique_ptr<ui::LayerTreeOwner> image) {
+          operation = ui::mojom::DragOperation::kCopy;
+          std::move(drop).Run();
+        },
+        std::move(drop));
+  }
+#endif
   if (!drop_info_) {
     return base::DoNothing();
   }
