+void BrowserView::AttachKryptonUi() {
+  if (!krypton_ui_)
+    return;
+  auto result = krypton_ui_->Attach();
+  if (!result.has_value())
+    ReportKryptonUiFailure(std::move(result.error()));
+}
+
+void BrowserView::ReportKryptonUiFailure(std::string error) {
+  if (!krypton_ui_ || suppress_layout_for_teardown_)
+    return;
+  suppress_layout_for_teardown_ = true;
+  krypton_ui_->Close();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(u"KryptonUI initialization failed");
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk));
+  dialog->SetContentsView(
+      std::make_unique<views::MessageBoxView>(base::UTF8ToUTF16(error)));
+  views::DialogDelegate::CreateDialogWidget(std::move(dialog), nullptr, nullptr)
+      ->Show();
+  GetWidget()->Close();
+}
