# Present Chromium Page Info commands through KryptonUI's native menu.
# Chromium still supplies security, policy, cookies and permission behavior;
# Krypton windows must not open a second Views bubble over their WinUI menu.
--- a/chrome/browser/ui/page_info/BUILD.gn
+++ b/chrome/browser/ui/page_info/BUILD.gn
@@ -41,7 +41,10 @@
     "chrome_page_info_delegate.cc",
     "chrome_page_info_ui_delegate.cc",
   ]
-  deps = []
+  deps = [ "//chrome/browser/ui/krypton_ui:buildflags" ]
+  if (is_win) {
+    deps += [ "//chrome/browser/ui/krypton_ui:native_headers" ]
+  }
 
   if (is_android) {
     deps += [ "//chrome/browser/android:resource_mapper" ]
--- a/chrome/browser/ui/page_info/page_info_dialog.cc
+++ b/chrome/browser/ui/page_info/page_info_dialog.cc
@@ -5,6 +5,10 @@
 #include "chrome/browser/ui/page_info/page_info_dialog.h"
 
 #include "base/no_destructor.h"
+#include "chrome/browser/ui/krypton_ui/buildflags.h"
+#if BUILDFLAG(ENABLE_KRYPTON_UI)
+#include "chrome/browser/ui/krypton_ui/site_info_menu.h"
+#endif
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
 #include "chrome/browser/ui/bubble_anchor_util.h"
@@ -38,6 +42,15 @@
           ? std::move(GetPageInfoDialogCreatedCallbackForTesting())
           : base::DoNothing();
 
+#if BUILDFLAG(ENABLE_KRYPTON_UI)
+  // The native shell owns popup lifetime, focus restoration and the PageInfo
+  // reload notification. Never also show the Views bubble in these windows.
+  if (krypton_ui::RequestSiteInfo(web_contents)) {
+    std::move(initialized_callback).Run();
+    return true;
+  }
+#endif
+
   ShowPageInfoDialogImpl(browser, web_contents, entry->GetVirtualURL(), anchor,
                          std::move(initialized_callback),
                          std::move(closing_callback), type);
