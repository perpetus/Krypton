     case user_data_importer::TYPE_PERPLEXITY_COMET:
     case user_data_importer::TYPE_BRAVE:
+    case user_data_importer::TYPE_HELIUM:
+    case user_data_importer::TYPE_THORIUM:
       return true;
     default:
       return false;
