+  // The cache migration precedes shortcut-manager construction. Refresh only
+  // existing generated shortcuts whose recorded old name matches that rename.
+  for (auto* entry : storage.GetAllProfilesAttributes()) {
+    if (!entry->IsUsingDefaultName())
+      continue;
+    const auto old_name = entry->GetShortcutName();
+    if (old_name.find(u"Helium") == std::u16string::npos)
+      continue;
+    if (krypton::branding::ShouldRefreshDefaultProfileShortcut(
+            old_name, entry->GetName(), /*is_default=*/true)) {
+      CreateOrUpdateShortcutsForProfileAtPath(
+          entry->GetPath(), UPDATE_EXISTING_ONLY, IGNORE_NON_PROFILE_SHORTCUTS,
+          /*incognito=*/false);
+    }
+  }
