+#if BUILDFLAG(IS_WIN)
+void PageSchedulerImpl::UpdateBackgroundWakeUpGracePeriod() {
+  if (IsPageVisible()) {
+    return;
+  }
+  const auto grace = GetIntensiveWakeUpThrottlingGracePeriod(IsLoading());
+  const auto limit = main_thread_scheduler_->IsBatterySaverEnabled()
+                         ? std::min(grace, base::Seconds(30))
+                         : grace;
+  const auto remaining = page_visibility_changed_time_ + limit -
+                         main_thread_scheduler_->NowTicks();
+  do_intensively_throttle_wake_ups_callback_.Cancel();
+  const bool throttle = !remaining.is_positive();
+  if (are_wake_ups_intensively_throttled_ != throttle) {
+    are_wake_ups_intensively_throttled_ = throttle;
+    base::LazyNow lazy_now(main_thread_scheduler_->GetTickClock());
+    UpdateWakeUpBudgetPools(&lazy_now);
+  }
+  if (!throttle) {
+    main_thread_scheduler_->ControlTaskRunner()->PostDelayedTask(
+        FROM_HERE, do_intensively_throttle_wake_ups_callback_.GetCallback(),
+        remaining);
+  }
+}
+#endif
 
