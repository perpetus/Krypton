# Expose unplugged and always-on Windows energy saver in Performance settings.
#
# Reuse the existing local-state setting and metrics values. Keep the same
# setting available on desktop PCs so users can select Always.

--- a/chrome/app/settings_strings.grdp
+++ b/chrome/app/settings_strings.grdp
@@ -1240,6 +1240,9 @@
     </message>
     <message name="IDS_SETTINGS_PERFORMANCE_BATTERY_SAVER_MODE_SETTING" desc="Energy saver mode setting label. This mode allows the browser to conserve battery by reducing energy usage">
       Energy Saver
+    </message>
+    <message name="IDS_SETTINGS_PERFORMANCE_BATTERY_SAVER_ALWAYS_LABEL" desc="Label for the energy saver option which is enabled on battery and external power">
+      Always
     </message>
     <message name="IDS_SETTINGS_PERFORMANCE_BATTERY_SAVER_MODE_ON_BATTERY_LABEL" desc="Label for the energy saver mode option which is enabled when unplugged option">
       Turn on when your computer is unplugged
