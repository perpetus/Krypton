+#if BUILDFLAG(IS_WIN)
+std::optional<bool> ChromeRuntimeAPIDelegate::DeferBackgroundAssetUpdates(
+    const Extension* extension) {
+  if (!extension || extension->id() != helium::kUBlockOriginComponentId ||
+      extension->location() !=
+          extensions::mojom::ManifestLocation::kComponent) {
+    return std::nullopt;
+  }
+  using BatterySaverManager =
+      performance_manager::user_tuning::BatterySaverModeManager;
+  return (BatterySaverManager::HasInstance() &&
+          BatterySaverManager::GetInstance()->IsWindowsEnergySaverActive()) ||
+         net::NetworkChangeNotifier::GetConnectionCost() ==
+             net::NetworkChangeNotifier::CONNECTION_COST_METERED;
+}
+#endif
