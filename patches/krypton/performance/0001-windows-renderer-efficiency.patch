-  static void ApplyProcessPriorityOnLauncherThread(
-      base::Process& process,
-      base::Process::Priority priority);
+  void ApplyProcessPriorityOnLauncherThread(base::Process& process,
+                                            base::Process::Priority priority);
 #endif  // !BUILDFLAG(IS_ANDROID)
 
 #if BUILDFLAG(IS_ANDROID)
--- a/content/browser/child_process_launcher_helper_win.cc
+++ b/content/browser/child_process_launcher_helper_win.cc
@@ -221,9 +221,22 @@
     base::Process& process,
     base::Process::Priority priority) {
   CHECK(CurrentlyOnProcessLauncherTaskRunner(), base::NotFatalUntil::M159);
-  if (process.CanSetPriority()) {
-    process.SetPriority(priority);
-  }
+  if (!process.CanSetPriority()) {
+    return;
+  }
+  process.SetPriority(priority);
+  if (GetProcessType() != switches::kRendererProcess) {
+    return;
+  }
+  const bool background = priority == base::Process::Priority::kBestEffort;
+  base::win::SetProcessTimerThrottleState(
+      process.Handle(), background ? base::win::ProcessPowerState::kEnabled
+                                   : base::win::ProcessPowerState::kUnset);
+  MEMORY_PRIORITY_INFORMATION memory_priority{};
+  memory_priority.MemoryPriority =
+      background ? MEMORY_PRIORITY_LOW : MEMORY_PRIORITY_NORMAL;
+  ::SetProcessInformation(process.Handle(), ProcessMemoryPriority,
+                          &memory_priority, sizeof(memory_priority));
 }
 
