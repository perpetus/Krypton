# Apply Windows timer and memory priority at the existing renderer priority boundary.
#
# The visibility and media voters determine the final priority of a shared
# renderer. Protect WebRTC and picture-in-picture before treating the lowest
# priority as eligible for more aggressive Windows power settings.

--- a/content/browser/child_process_launcher_helper.h
+++ b/content/browser/child_process_launcher_helper.h
@@ -301,9 +301,8 @@
 
 #if !BUILDFLAG(IS_ANDROID)
