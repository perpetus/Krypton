# Keep Helium's custom keyboard shortcuts without Helium's layouts.
#
# Krypton skips Helium's browser-chrome UI (patches/skip-helium), including
# its layout patches, which define the layout prefs and the layout-switch,
# Ctrl+S vertical-tabs and zen-mode pin commands. Helium's shortcut list
# refers to all of them. Drop those entries; KryptonUI owns layout switching.
# Chromium's own vertical-tabs collapse command and every other shortcut
# stay as Helium has them.

--- a/chrome/browser/ui/browser_shortcuts/browser_shortcut_metadata.cc
+++ b/chrome/browser/ui/browser_shortcuts/browser_shortcut_metadata.cc
@@ -12,7 +12,6 @@
 #include "base/check.h"
 #include "build/build_config.h"
 #include "chrome/app/chrome_command_ids.h"
-#include "chrome/browser/ui/helium/helium_layout_state_controller.h"
 #include "chrome/common/pref_names.h"
 #include "chrome/grit/generated_resources.h"
 #include "components/prefs/pref_service.h"
@@ -21,12 +20,6 @@
 namespace browser_shortcuts {
 
 namespace {
-
-bool ShouldUseVerticalCollapseLabel(const PrefService* prefs) {
-  return prefs && prefs->GetBoolean(prefs::kVerticalCollapseShortcut) &&
-         prefs->GetInteger(prefs::kHeliumLayout) ==
-             std::to_underlying(HeliumLayoutType::kVertical);
-}
 
 bool ShouldUseCopyPageUrlLabel(const PrefService* prefs) {
   return prefs && prefs->GetBoolean(prefs::kCopyPageUrlShortcut);
@@ -202,10 +195,6 @@
       return Label(IDS_OPEN_FILE_DIALOG_TITLE);
     case IDC_SAVE_PAGE:
       return Label(IDS_SAVE_PAGE);
-    case IDC_CTRL_S_SHORTCUT:
