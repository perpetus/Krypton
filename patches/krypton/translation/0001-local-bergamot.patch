+  // Krypton: profile isolation comes from the requesting document, never an
+  // active window or a URL lookup. Older providers retain their existing seam.
+  virtual std::unique_ptr<TranslationSession> StartSession(
+      const GURL& url,
+      content::BrowserContext*) {
+    return StartSession(url);
+  }
 };
 
