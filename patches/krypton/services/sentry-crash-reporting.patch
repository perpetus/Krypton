 #include "build/branding_buildflags.h"
 #include "build/build_config.h"
-
-#include "base/check.h"
+#include "components/crash/core/app/krypton_crash_reporting_buildflags.h"
 
 // On Windows don't use FilePath.
 // http://crbug.com/604923
@@ -154,7 +155,7 @@
 #endif
 
 #if defined(OFFICIAL_BUILD)
-  return std::string();  // No Krypton crash endpoint yet.
+  return BUILDFLAG(KRYPTON_CRASH_UPLOAD_URL);
 #else
   return std::string();
 #endif
@@ -170,7 +171,15 @@
 
 std::map<std::string, std::string>
 CrashReporterClient::GetExtraProcessAnnotations() {
-  return {};
+  // Crashpad forwards these fields in the existing minidump multipart upload.
+  // Keep metadata technical: no browsing history, page URLs or user identity.
+  return {
+      {"sentry[release]",
+       "krypton@" + std::string(version_info::GetHeliumVersionNumber())},
+      {"sentry[environment]", BUILDFLAG(KRYPTON_CRASH_ENVIRONMENT)},
+      {"sentry[tags][chromium_version]",
+       std::string(version_info::GetVersionNumber())},
+  };
 }
 
