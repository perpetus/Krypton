Enable Krypton crash reporting through its existing Crashpad transport.

Krypton uses its own configured HTTPS minidump endpoint, initially Sentry Cloud,
while preserving Helium's Ask/Automatic/Disabled consent, policy and upload
rate limits. Keep the endpoint empty by default; release flags select the
public ingestion URL and environment. Sentry release metadata contains only
build versions. This adds no second crash handler, analytics, traces or logs.
The existing disabled-endpoint and visible-branding patches remain earlier
layers; this final patch enables only the separately configured crash service.

--- a/components/crash/core/app/BUILD.gn
+++ b/components/crash/core/app/BUILD.gn
@@ -6,10 +6,32 @@
 assert(!is_fuchsia)
 
 import("//base/debug/debug.gni")
+import("//build/buildflag_header.gni")
 import("//components/gwp_asan/buildflags/buildflags.gni")
 
 if (is_android) {
   import("//build/config/android/config.gni")
+}
+
+declare_args() {
+  # Empty keeps upload transport disabled. The public ingestion key is not an
+  # authentication token; account credentials must never enter the build.
+  krypton_crash_upload_url = ""
+  krypton_crash_environment = "development"
+}
+
+if (krypton_crash_upload_url != "") {
+  _krypton_crash_url_parts = string_split(krypton_crash_upload_url, "://")
+  assert(_krypton_crash_url_parts[0] == "https",
+         "Krypton crash uploads require HTTPS.")
+}
+
+buildflag_header("krypton_crash_reporting_buildflags") {
+  header = "krypton_crash_reporting_buildflags.h"
+  flags = [
+    "KRYPTON_CRASH_UPLOAD_URL=\"$krypton_crash_upload_url\"",
+    "KRYPTON_CRASH_ENVIRONMENT=\"$krypton_crash_environment\"",
+  ]
 }
 
 source_set("lib") {
@@ -21,7 +43,9 @@
   ]
 
   deps = [
+    ":krypton_crash_reporting_buildflags",
     "//base",
+    "//base/version_info",
     "//build:branding_buildflags",
   ]
 }
