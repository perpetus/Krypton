+
+content::WebContents* HeadlessWebContentsManager::CreateHidden(
+    scoped_refptr<content::SiteInstance> site_instance) {
+  CHECK(site_instance);
+  content::WebContents::CreateParams params(browser_context_,
+                                            std::move(site_instance));
+  params.initially_hidden = true;
+  auto contents = content::WebContents::Create(params);
   contents->SetDelegate(this);
   return contents_.emplace_back(std::move(contents)).get();
 }
