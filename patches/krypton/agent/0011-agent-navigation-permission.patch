+
 namespace actor {
+namespace {
+
+// Exclude history transfers, which can replay an earlier typed transition.
+bool IsUserUiNavigation(content::NavigationHandle& navigation) {
+  if (navigation.IsRendererInitiated()) {
+    return false;
+  }
+  const auto transition = navigation.GetPageTransition();
+  return !(transition & ::ui::PAGE_TRANSITION_FORWARD_BACK) &&
+         (::ui::PageTransitionCoreTypeIs(transition,
+                                         ::ui::PAGE_TRANSITION_TYPED) ||
+          ::ui::PageTransitionCoreTypeIs(transition,
+                                         ::ui::PAGE_TRANSITION_GENERATED) ||
+          ::ui::PageTransitionCoreTypeIs(transition,
+                                         ::ui::PAGE_TRANSITION_AUTO_BOOKMARK) ||
+          (transition & ::ui::PAGE_TRANSITION_HOME_PAGE) ||
+          (transition & ::ui::PAGE_TRANSITION_FROM_ADDRESS_BAR));
+}
+
+}  // namespace
 
