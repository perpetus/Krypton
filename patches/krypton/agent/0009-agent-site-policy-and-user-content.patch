# Krypton: expose a semantic user-content marker in page extraction without copying DOM attributes.
--- a/third_party/blink/renderer/modules/content_extraction/ai_page_content_agent.cc
+++ b/third_party/blink/renderer/modules/content_extraction/ai_page_content_agent.cc
@@ -2877,7 +2877,8 @@
     }
   }
 
-  if (!attributes.annotated_roles.empty()) {
+  if (attributes.user_generated_content ||
+      !attributes.annotated_roles.empty()) {
     return false;
   }
 
@@ -3167,6 +3168,28 @@
   const ax::mojom::blink::Role aria_role =
       element ? AXObject::DetermineRawAriaRole(*element)
               : ax::mojom::blink::Role::kUnknown;
+  if (actionable_mode() && element) {
+    DEFINE_STATIC_LOCAL(const AtomicString, itemtype_name, ("itemtype"));
+    DEFINE_STATIC_LOCAL(const AtomicString, ugc_token, ("ugc"));
+    const SpaceSplitString relations(
+        element->getAttribute(html_names::kRelAttr));
+    attributes.user_generated_content = relations.Contains(ugc_token);
+    const SpaceSplitString types(element->getAttribute(itemtype_name));
+    for (wtf_size_t index = 0; index < types.size(); ++index) {
+      const StringView type(types[index]);
+      const StringView suffix =
+          type.starts_with("https://schema.org/")  ? type.substr(19)
+          : type.starts_with("http://schema.org/") ? type.substr(18)
+                                                   : StringView();
+      if (suffix == "Comment" || suffix == "Review" ||
+          suffix == "DiscussionForumPosting" ||
+          suffix == "SocialMediaPosting" || suffix == "QAPage" ||
+          suffix == "Answer") {
+        attributes.user_generated_content = true;
+        break;
+      }
+    }
+  }
   AddAnnotatedRoles(object, aria_role, attributes.annotated_roles);
   PopulateLabelForDomNodeId(object, attributes);
 
--- a/third_party/blink/public/mojom/content_extraction/ai_page_content.mojom
+++ b/third_party/blink/public/mojom/content_extraction/ai_page_content.mojom
@@ -659,6 +659,9 @@
   // Indicates whether the contents of this element have been determined to be
   // an ad.
   bool is_ad_related;
+
+  // Rendered regions identified as user-authored from document markup.
+  bool user_generated_content;
 };
 
