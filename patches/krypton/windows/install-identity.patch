# Install and run beside Helium without sharing anything with it.
#
# Helium's install mode decides the profile folder, registry keys, app and
# ProgIDs, the direct-launch URL scheme, and the COM classes for toasts and
# the elevation service. With Helium's values Krypton would open Helium's
# profile and overwrite its registrations, so those, and the policy key, get
# Krypton's own. Internal names such as helium.7z stay as Helium ships them.
# The values are the ones Krypton already installed with.

--- a/chrome/install_static/chromium_install_modes.h
+++ b/chrome/install_static/chromium_install_modes.h
@@ -17,11 +17,11 @@
 
