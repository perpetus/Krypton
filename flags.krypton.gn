# Krypton's GN args, appended after Helium's flags.gn and helium-windows'
# flags.windows.gn.
#
# Add-only except the two approved Cast discovery args documented below.
# build.py rejects all other upstream overrides. `gn gen --fail-on-unused-args`
# also rejects arguments no longer declared by the pinned source.

# --- Linking -------------------------------------------------------------------
# Helium sets symbol_level = 1; that stands.
use_thin_lto = true
thin_lto_enable_optimizations = true
use_text_section_splitting = true
krypton_thinlto_opt_level = 3
krypton_thinlto_codegen_opt_level = 3
krypton_thinlto_jobs = 1
# Browser linker workers are separate from automatic compilation parallelism.
krypton_browser_link_jobs = 1
krypton_concurrent_links = 1

# --- V8 --------------------------------------------------------------------------
# v8_enable_builtins_optimization is left to derive from chrome_pgo_phase;
# builtins PGO fails silently when profiles are absent.
v8_enable_fast_torque = true
v8_enable_wasm_simd256_revec = true

# --- Widevine DRM ----------------------------------------------------------------
# Helium already sets enable_widevine. The CDM arrives through the component
# updater (see patches/krypton/services/component-updates-upstream-fallback);
# bundle_widevine_cdm stays false because it needs a prebuilt CDM only Google
# has. enable_cdm_host_verification stays at its default: it needs Widevine
# signing certificates Google does not distribute, and L3 playback works
# without it.
enable_library_cdms = true
ignore_missing_widevine_signing_cert = true

# --- Codecs and hardware decode --------------------------------------------------
# These require proprietary_codecs, which Helium sets.
enable_ffmpeg_video_decoders = true
is_component_ffmpeg = false

# HEVC / H.265. enable_hevc_parser_and_hw_decoder requires
# enable_platform_hevc.
enable_platform_hevc = true
enable_hevc_parser_and_hw_decoder = true
platform_has_optional_hevc_decode_support = true
platform_has_optional_hevc_encode_support = true

# HLS requires enable_mse_mpeg2ts_stream_parser, which Helium sets.
enable_hls_demuxer = true

# Surround sound and HDR. Dolby Vision requires enable_platform_hevc;
# encrypted Dolby Vision requires enable_platform_dolby_vision.
enable_platform_ac3_eac3_audio = true
enable_platform_dolby_vision = true
enable_platform_encrypted_dolby_vision = true
enable_platform_mpeg_h_audio = true
enable_platform_dts_audio = true

# --- WebRTC ------------------------------------------------------------------------
rtc_use_h264 = true
rtc_use_h265 = true
rtc_enable_avx2 = true

# --- Microarchitecture: x86-64-v3 (AVX2) -----------------------------------------
# Declared by patches/krypton/build/simd-and-max-optimization.patch. build.py
# drops this block for ARM64 builds. use_aggressive_ext_opt and use_gvn_hoist,
# from the same patch, stay off: neither has a demonstrated win on a browser
# workload, and use_gvn_hoist has known miscompiles.
use_sse3 = true
use_sse41 = true
use_sse42 = true
use_avx = true
use_avx2 = true
use_avx512 = false
use_fma = true

# Krypton: optional Cast compilation; requires runtime discovery consent.
enable_mdns = true
enable_service_discovery = true
